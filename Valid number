#include <stdbool.h>
#include <ctype.h>

bool isNumber(char* s) {
    bool seen_digit = false;
    bool seen_dot = false;
    bool seen_exponent = false;
    
    for (int i = 0; s[i] != '\0'; i++) {
        char c = s[i];
        
        if (isdigit((unsigned char)c)) {
            seen_digit = true;
        } 
        else if (c == '+' || c == '-') {
            if (i > 0 && s[i - 1] != 'e' && s[i - 1] != 'E') {
                return false;
            }
        } 
        else if (c == 'e' || c == 'E') {
            if (seen_exponent || !seen_digit) {
                return false;
            }
            seen_exponent = true;
            seen_digit = false; 
        } 
        else if (c == '.') {
            if (seen_dot || seen_exponent) {
                return false;
            }
            seen_dot = true;
        } 
        else {
            return false;
        }
    }
    
    return seen_digit;
}
