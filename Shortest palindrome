int* computeLPS(char* str, int len) {
    int* lps = (int*)malloc(len * sizeof(int));
    lps[0] = 0;
    int i = 1, j = 0;
    while (i < len) {
        if (str[i] == str[j]) {
            j++;
            lps[i] = j;
            i++;
        } else {
            if (j != 0) {
                j = lps[j - 1];
            } else {
                lps[i] = 0;
                i++;
            }
        }
    }
    return lps;
}

char* shortestPalindrome(char* s) {
    int len = strlen(s);
    if (len <= 1) return s;

    char* rev = (char*)malloc((len + 1) * sizeof(char));
    for (int i = 0; i < len; i++) {
        rev[i] = s[len - 1 - i];
    }
    rev[len] = '\0';

    int comb_len = len + 1 + len;
    char* comb = (char*)malloc((comb_len + 1) * sizeof(char));
    strcpy(comb, s);
    comb[len] = '#';
    strcpy(comb + len + 1, rev);

    int* lps = computeLPS(comb, comb_len);
    int pal_len = lps[comb_len - 1];

    free(lps);
    free(comb);

    int add_len = len - pal_len;
    char* res = (char*)malloc((add_len + len + 1) * sizeof(char));
    strncpy(res, rev, add_len);
    strcpy(res + add_len, s);

    free(rev);
    return res;
}
