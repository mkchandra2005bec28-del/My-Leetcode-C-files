#include <bits/stdc++.h>
using namespace std;

class Solution {
public:
    string countAndSay(int n) {
        string s = "1";

        for (int step = 2; step <= n; step++) {
            string next = "";

            int i = 0;

            while (i < s.size()) {
                int count = 1;

                while (i + count < s.size() &&
                       s[i + count] == s[i]) {
                    count++;
                }

                next += to_string(count);
                next += s[i];

                i += count;
            }

            s = next;
        }

        return s;
    }
};
