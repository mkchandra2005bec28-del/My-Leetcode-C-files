int calculate(char* s) {
    long long result = 0;
    long long sign = 1;

    long long stack[100000];
    int top = -1;

    for (int i = 0; s[i] != '\0'; i++) {

        if (s[i] >= '0' && s[i] <= '9') {
            long long num = 0;

            while (s[i] >= '0' && s[i] <= '9') {
                num = num * 10 + (s[i] - '0');
                i++;
            }

            result += sign * num;
            i--;
        }
        else if (s[i] == '+') {
            sign = 1;
        }
        else if (s[i] == '-') {
            sign = -1;
        }
        else if (s[i] == '(') {
            stack[++top] = result;
            stack[++top] = sign;

            result = 0;
            sign = 1;
        }
        else if (s[i] == ')') {
            long long previousSign = stack[top--];
            long long previousResult = stack[top--];

            result = previousResult + previousSign * result;
        }
    }

    return (int)result;
}
